# Copy to .env.local (git-ignored). Server-only: never prefix these with NEXT_PUBLIC_,
# or the value would be inlined into the browser bundle.

# Base URL of the Fastify backend. No trailing slash.
BACKEND_API_URL=http://127.0.0.1:8000

# Sent as the x-api-key header when set. Leave empty when the backend runs without API_KEY.
BACKEND_API_KEY=

# Password gate for the whole app (HTTP Basic Auth). Required in production: without both
# values a production build refuses to serve (503). Leave both empty for local development.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
